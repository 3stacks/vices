{
  "name": "Vices",
  "version": "1.0.0",
  "description": "",
  "main": "src/index.js",
  "scripts": {
  	"start": "npm run watch",
    "clean": "rm -rf dist",
    "prepare-dirs": "mkdir dist",
    "build": "NODE_ENV=production && npm run build-primer && concurrently \"npm run build-core\" \"npm run build-extra-resources\"",
    "build-primer": "npm run clean && npm run prepare-dirs",
    "build-core": "concurrently \"npm run build-js\" \"npm run build-html\" \"npm run build-styles\"",
    "build-extra-resources": "npm run build-images",
    "build-js": "webpack -p --config webpack.config.js --color --display-error-details --devtool=sourcemap",
    "build-styles": "node-sass ./src/sass --output ./dist",
    "build-images": "cp -a ./src/img ./dist",
    "build-html": "cp -a ./src/html/index.html dist",
    "watch": "npm run build && npm run watch-js & npm run watch-styles & npm run watch-images & npm run watch-html",
    "watch-js": "webpack --config webpack.config.js --progress --color --display-error-details --watch --debug --output-pathinfo",
    "watch-styles": "node-sass ./src/sass --output ./dist --watch",
    "watch-images": "cpx \"src/img/*\" dist/img --watch -v",
    "watch-html": "cpx \"src/html/**/*\" dist --watch -v"
  },
  "repository": {
    "type": "git",
    "url": "git+https://_lnk@bitbucket.org/_LNK/agenda.git"
  },
  "author": "",
  "license": "ISC",
  "homepage": "https://bitbucket.org/_LNK/agenda#readme",
  "devDependencies": {
    "babel": "^6.5.2",
    "babel-cli": "^6.9.0",
    "babel-core": "^6.18.2",
    "babel-loader": "^6.2.4",
    "babel-plugin-syntax-jsx": "^6.13.0",
    "babel-plugin-transform-object-rest-spread": "^6.8.0",
    "babel-plugin-transform-react-jsx": "^6.8.0",
    "babel-plugin-transform-runtime": "^6.8.0",
    "babel-preset-es2015": "^6.6.0",
    "babel-preset-es2017": "^6.9.2",
    "babel-preset-react": "^6.23.0",
    "babelify": "^7.3.0",
    "browserify": "^13.0.0",
    "concurrently": "^2.2.0",
    "cpx": "^1.3.2",
    "gulp": "^3.9.1",
    "gulp-rename": "^1.2.2",
    "gulp-sass": "^2.3.1",
    "node-sass": "^3.7.0",
    "rimraf": "^2.5.2",
    "vinyl-source-stream": "^1.1.0",
    "webpack": "^2.1.0-beta.20"
  },
  "dependencies": {
    "ajax-event": "^1.0.2",
    "array-flatten": "^2.0.0",
    "axios": "^0.11.0",
    "capitalize": "^1.0.0",
    "local-storage-manager": "^1.1.3",
    "material-ui": "^0.17.0",
    "react": "^15.0.1",
    "react-dom": "^15.0.1",
    "react-tap-event-plugin": "^2.0.1"
  }
}
